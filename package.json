{
	"name": "chevere_max_server",
	"version": "1.0.0",
	"description": "Servidor para venta de tickets",
	"main": "src/main.ts",
	"type": "module",
	"scripts": {
		"dev": "NODE_OPTIONS=\"--max-old-space-size=3072\" tsx watch --ignore ./logs --ignore ./dist src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/main.js",
		"test": "tsx --test src/**/__tests__/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"seed:admin": "tsx src/seed/seed-admin.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@getbrevo/brevo": "^6.0.3",
		"axios": "^1.20.0",
		"better-auth": "^1.7.2",
		"big.js": "^7.0.1",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.21.2",
		"mongodb": "^7.6.0",
		"mongoose": "^8.9.5",
		"nodemailer": "^10.0.0",
		"socket.io": "^4.8.3",
		"sse-channel": "^4.0.2",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/big.js": "^7.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.21",
		"@types/node": "^22.13.0",
		"@types/nodemailer": "^8.0.1",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3"
	}
}
