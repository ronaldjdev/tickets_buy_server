{
	"name": "tickets_buy_server",
	"version": "1.0.0",
	"description": "Servidor para venta de tickets",
	"main": "src/main.ts",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsc",
		"start": "node dist/main.js",
		"test": "tsx --test src/features/**/__tests__/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.21.2",
		"mongoose": "^8.9.5",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.21",
		"@types/node": "^22.13.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3"
	}
}
